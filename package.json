{
  "name": "typescript-express-supabase-boilerplate",
  "version": "1.0.0",
  "description": "Production-ready boilerplate for Express with TypeScript and Supabase",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "typescript",
    "express",
    "supabase",
    "boilerplate",
    "rest-api",
    "backend"
